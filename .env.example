# --- Server ---
PORT=3000
# In locale 127.0.0.1; con NODE_ENV=production diventa 0.0.0.0 (richiesto dai cloud)
HOST=
NODE_ENV=
# Cartella del database e degli allegati. Su cloud DEVE puntare al disco/volume persistente
# (Render: /var/data · Railway: automatico da RAILWAY_VOLUME_MOUNT_PATH)
DATA_DIR=./data
# Password di accesso (schermata di login). OBBLIGATORIA in produzione.
APP_PASSWORD=
# Facoltativo: chiave per firmare le sessioni (default: derivata da APP_PASSWORD)
SESSION_SECRET=
# Solo se il frontend è ospitato su un altro dominio:
PUBLIC_API_URL=
CORS_ORIGINS=
# 0 = disattiva lo snapshot giornaliero del database
BACKUP=1

# --- IA per coach, parsing, brief: anthropic | openai | (vuoto = solo regole locali) ---
AI_PROVIDER=anthropic
AI_TIMEOUT_MS=30000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI o qualunque server compatibile (Groq, OpenRouter, Ollama: http://localhost:11434/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Trascrizione vocale (Whisper). Vuoto = usa OPENAI_API_KEY. ---
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
